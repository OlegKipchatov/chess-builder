{
  "name": "chess-vault",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:engine": "node scripts/prepare-stockfish.mjs",
    "prestart": "node scripts/prepare-stockfish.mjs",
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8080 --directory dist",
    "simulate:collect": "node scripts/simulation/cognitive-v2-holdout.mjs",
    "simulate": "node scripts/simulation/cognitive-v2.mjs",
    "simulate:conversion": "node scripts/simulation/conversion-v2.1.mjs",
    "motion:generate": "node scripts/generate-motion.mjs",
    "motion:check": "node scripts/generate-motion.mjs --check",
    "test:pwa:browser": "node scripts/test-pwa-browser.mjs",
    "benchmark:analysis": "node scripts/benchmark-analysis.mjs docs/analysis-benchmark-linux.json",
    "test:stockfish:browser": "node scripts/test-stockfish-compatibility-browser.mjs",
    "test:pwa:single": "PWA_NO_ISOLATION=1 node scripts/test-pwa-browser.mjs"
  },
  "description": "Устанавливаемые офлайн-шахматы с коллекционными скинами",
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
