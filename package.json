{
  "name": "chess-vault",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:engine": "node scripts/prepare-stockfish.mjs",
    "prestart": "node scripts/prepare-stockfish.mjs",
    "test": "node --import tsx --test tests/*.test.js && vitest run",
    "start": "python3 -m http.server 8080 --directory dist",
    "simulate:collect": "node scripts/simulation/cognitive-v2-holdout.mjs",
    "simulate": "node scripts/simulation/cognitive-v2.mjs",
    "simulate:conversion": "node scripts/simulation/conversion-v2.1.mjs",
    "motion:generate": "node scripts/generate-motion.mjs",
    "motion:check": "node scripts/generate-motion.mjs --check",
    "test:pwa:browser": "node scripts/test-pwa-browser.mjs",
    "benchmark:analysis": "node scripts/benchmark-analysis.mjs docs/analysis-benchmark-linux.json",
    "test:stockfish:browser": "node scripts/test-stockfish-compatibility-browser.mjs",
    "test:pwa:single": "PWA_NO_ISOLATION=1 node scripts/test-pwa-browser.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "build": "vite build",
    "test:unit": "node --import tsx --test tests/*.test.js",
    "test:react": "vitest run",
    "preview": "vite preview"
  },
  "description": "Устанавливаемые офлайн-шахматы с коллекционными скинами",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.21",
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
